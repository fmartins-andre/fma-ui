{
  "name": "@fmartinsandre/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit && pnpm generate:registry && pnpm registry:build",
    "dev": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "generate:registry": "tsx scripts/gen-registry-json.ts",
    "registry:build": "shadcn build --cwd . --output ../../apps/web/public/r",
    "add:shadcn": "tsx scripts/add-shadcn.ts",
    "add:registry": "tsx scripts/add-from-registry.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fmartinsandre/registry": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react-aria-components": "^1.21.1",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.11"
  }
}
