ypeof ARTWORK;\n  logoClassName?: string;\n};\n\n/*\n * The issuer colors are content, like a file type's brand color: they stay\n * the same in every theme. Issuers without a look of their own take the theme\n * gray and their name as text.\n */\nconst ISSUER_LOOKS: Record<string, IssuerLook> = {\n  \"american-express\": {\n    background: \"bg-[linear-gradient(25deg,#308c67,#a3f2cf)]\",\n    logo: \"american-express\",\n  },\n  \"diners-club\": {\n    background: \"bg-[linear-gradient(25deg,#fff,#eee)]\",\n    isLight: true,\n    logo: \"diners-club\",\n  },\n  discover: {\n    background: \"bg-[linear-gradient(25deg,#fff,#eee)]\",\n    isLight: true,\n    logo: \"discover\",\n  },\n  elo: { background: \"bg-[linear-gradient(25deg,#211c18,#aaa7a2)]\", logo: \"elo\" },\n  hipercard: { background: \"bg-[linear-gradient(25deg,#8b181b,#de1f27)]\", logo: \"hipercard\" },\n  jcb: { logo: \"jcb\" },\n  mastercard: {\n    background: \"bg-[linear-gradient(25deg,#fbfbfb,#e8e9e5)]\",\n    isLight: true,\n    logo: \"mastercard\",\n  },\n  visa: {\n    background: \"bg-[linear-gradient(25deg,#0f509e,#1399cd)]\",\n    logo: \"visa\",\n    logoClassName: \"w-[30%]\",\n  },\n};\n\n/* -------------------------------------------------------------------------- */\n/*                                 Formatting                                 */\n/* -------------------------------------------------------------------------- */\n\nconst PLACEHOLDER = \"•\";\n/** Characters that stand for a hidden digit in a saved card's number. */\nconst HIDDEN_DIGIT = /[*•xX]/;\n\n/**\n * The number padded with `•` to its issuer's length and broken into groups:\n * 4-4-4-4, Amex 4-6-5. Hidden digits (`*`, `x`) show as `•` too.\n */\nfunction formatNumber(number: string, issuer: CreditCardIssuer | null) {\n  const chars = [...number].filter((char) => /\\d/.test(char) || HIDDEN_DIGIT.test(char));\n  const lengths = issuer?.lengths ?? [16, 19];\n  const length = Math.min(\n    lengths.find((candidate) => candidate >= chars.length) ?? Math.max(...lengths),\n    19,\n  );\n  const gaps = issuer?.gaps ?? [4, 8, 12];\n  let text = \"\";\n  for (let index = 0; index < length; index++) {\n    if (gaps.includes(index)) text += \" \";\n    const char = chars[index];\n    text += char && /\\d/.test(char) ? char : PLACEHOLDER;\n  }\n  return { text, length, isFilled: chars.length > 0, digits: chars.slice(0, length).join(\"\") };\n}\n\n/** `MM/YY` from `MM/YY`, `MM/YYYY`, `MMYY` or `MMYYYY`, padded with `•`. */\nfunction formatExpiry(expiry: string) {\n  let [month = \"\", year = \"\"] = expiry.includes(\"/\")\n    ? expiry.split(\"/\")\n    : [expiry.slice(0, 2), expiry.slice(2)];\n  month = month.replace(/\\D/g, \"\").slice(0, 2);\n  year = year.replace(/\\D/g, \"\");\n  if (year.length > 2) year = year.slice(2, 4);\n  return {\n    text: `${month.padEnd(2, PLACEHOLDER)}/${year.padEnd(2, PLACEHOLDER)}`,\n    isComplete: month.length === 2 && year.length === 2,\n    isFilled: month.length > 0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/*                                 Component                                  */\n/* -------------------------------------------------------------------------- */\n\ntype CreditCardField = \"number\" | \"name\" | \"expiry\" | \"cvc\";\n\ntype CreditCardLabels = {\n  /** The caption above the expiry date. */\n  validThru: string;\n  /** Shown while `name` is empty. */\n  namePlaceholder: string;\n  /** The card's accessible name, read in place of the drawing. */\n  card: (card: { issuer?: string; lastDigits?: string; expiry?: string }) => string;\n};\n\nconst defaultCreditCardLabels: CreditCardLabels = {\n  validThru: \"valid thru\",\n  namePlaceholder: \"YOUR NAME HERE\",\n  card: ({ issuer, lastDigits, expiry }) =>\n    `${issuer ?? \"Credit\"} card${lastDigits ? ` ending in ${lastDigits}` : \"\"}${\n      expiry ? `, expires ${expiry}` : \"\"\n    }`,\n};\n\ntype CreditCardProps = Omit<ComponentProps<\"div\">, \"children\"> & {\n  /** The card number, with or without spaces; `*` or `x` hide a digit (`**** **** **** 4242`). */\n  number?: string;\n  /** The holder's name, shown in capitals. */\n  name?: string;\n  /** `MM/YY`, `MM/YYYY`, `MMYY` or `MMYYYY`. */\n  expiry?: string;\n  /** The security code, on the back (on the front for Amex). */\n  cvc?: string;\n  /**\n   * The field being typed, highlighted on the card; `cvc` turns it to the back.\n   * Wire it to the form's focus.\n   */\n  focused?: CreditCardField | null;\n  /**\n   * The issuer id (`visa`, `mastercard`, `amex`…), for a saved card whose\n   * number is hidden. By default it comes from the number.\n   */\n  issuer?: string;\n  labels?: Partial<CreditCardLabels>;\n};\n\n/** The look of a field: dim while empty, brighter once filled, bold while typed. */\nconst FIELD =\n  \"opacity-50 transition-opacity duration-300 data-filled:opacity-80 data-focused:font-bold data-focused:opacity-100\";\n\n/**\n * A payment card drawn from its data, front and back: chip, issuer logo and\n * color, number, holder and expiry, and the security code. Shows a saved card\n * or previews one being typed. Sized by its width (`w-72` by default); the\n * text scales with it.\n */\nfunction CreditCard({\n  number = \"\",\n  name = \"\",\n  expiry = \"\",\n  cvc = \"\",\n  focused,\n  issuer: issuerProp,\n  labels: labelsProp,\n  className,\n  ...props\n}: CreditCardProps) {\n  const labels = { ...defaultCreditCardLabels, ...labelsProp };\n  const issuer = issuerProp ? getCreditCardIssuerById(issuerProp) : getCreditCardIssuer(number);\n  const look = (issuer && ISSUER_LOOKS[issuer.type]) || {};\n  const isAmex = issuer?.type === \"american-express\";\n  const isFlipped = focused === \"cvc\" && !isAmex;\n\n  const cardNumber = formatNumber(number, issuer);\n  const cardExpiry = formatExpiry(expiry);\n  const lastDigits = /\\d{4}$/.test(cardNumber.digits) ? cardNumber.digits.slice(-4) : undefined;\n\n  const face = cn(\n    \"absolute inset-0 overflow-hidden rounded-[5cqw] bg-muted-foreground backface-hidden\",\n    look.background\n      ? cn(\"shadow-lg\", look.isLight ? \"text-[#555]\" : \"text-white\")\n      : \"text-background\",\n  );\n  const sweep = (\n    <div\n      aria-hidden\n      className={cn(\n        \"absolute top-[-60%] h-[200%] w-[150%] rotate-25 transition-[left] duration-500 ease-out motion-reduce:transition-none\",\n        look.background ? cn(\"left-[-22%]\", look.background) : \"left-[-170%]\",\n      )}\n    />\n  );\n  const logo = (className?: string) =>\n    look.logo ? (\n      <img\n        alt=\"\"\n        src={svgSource(ARTWORK[look.logo])}\n        className={cn(\"absolute h-[23%] w-[40%] object-contain\", className, look.logoClassName)}\n      />\n    ) : issuer ? (\n      <span className={cn(\"absolute text-[5cqw] font-semibold italic\", className)}>\n        {issuer.niceType}\n      </span>\n    ) : null;\n\n  return (\n    <div\n      data-slot=\"credit-card\"\n      role=\"img\"\n      aria-label={labels.card({\n        issuer: issuer?.niceType,\n        lastDigits,\n        expiry: cardExpiry.isComplete ? cardExpiry.text : undefined,\n      })}\n      data-issuer={issuer?.type ?? \"unknown\"}\n      className={cn(\n        \"@container block w-72 shrink-0 font-mono leading-none perspective-[1000px] select-none\",\n        className,\n      )}\n      {...props}\n    >\n      <div\n        aria-hidden\n        data-flipped={isFlipped || undefined}\n        className=\"relative aspect-[1.5858] transition-transform duration-400 ease-linear transform-3d motion-reduce:transition-none data-flipped:rotate-y-180\"\n      >\n        <div data-slot=\"credit-card-front\" className={face}>\n          {sweep}\n          <img\n            alt=\"\"\n            src={svgSource(ARTWORK.chip)}\n            className=\"absolute top-[10%] left-[10%] h-[9.1cqw] w-[14.3cqw] object-contain\"\n          />\n          {logo(\"top-[10%] right-[10%] object-right-top text-right\")}\n          {isAmex && (\n            <div\n              data-focused={focused === \"cvc\" || undefined}\n              className={cn(\"absolute top-[38%] right-[10%] text-[4.1cqw]\", FIELD)}\n            >\n              {cvc}\n            </div>\n          )}\n          <div\n            data-focused={focused === \"number\" || undefined}\n            data-filled={cardNumber.isFilled || undefined}\n            className={cn(\n              \"absolute top-[45%] left-[10%] whitespace-pre\",\n              cardNumber.length > 16 ? \"text-[5.9cqw]\" : \"text-[6.9cqw]\",\n              FIELD,\n            )}\n          >\n            {cardNumber.text}\n          </div>\n          <div\n            data-focused={focused === \"name\" || undefined}\n            data-filled={name ? true : undefined}\n            className={cn(\n              \"absolute bottom-[15%] left-[10%] w-[60%] truncate text-[5.9cqw] uppercase\",\n              FIELD,\n            )}\n          >\n            {name || labels.namePlaceholder}\n          </div>\n          <div\n            data-focused={focused === \"expiry\" || undefined}\n            data-filled={cardExpiry.isFilled || undefined}\n            className={cn(\"absolute right-[10%] bottom-[15%]\", FIELD)}\n          >\n            <div className=\"mb-[1.7cqw] font-sans text-[3.4cqw]\">{labels.validThru}</div>\n            <div className=\"text-[5.5cqw]\">{cardExpiry.text}</div>\n          </div>\n        </div>\n        <div data-slot=\"credit-card-back\" className={cn(face, \"rotate-y-180\")}>\n          {sweep}\n          <div className=\"absolute top-[9%] h-[22%] w-full bg-[#2a1d16]\" />\n          <div className=\"absolute top-[35%] left-[5%] h-[18%] w-[75%] bg-[repeating-linear-gradient(0.1deg,#fff_20%,#fff_40%,#fea_40%,#fea_44%,#fff_44%)]\" />\n          <div\n            data-focused={focused === \"cvc\" || undefined}\n            data-filled={cvc ? true : undefined}\n            className={cn(\"absolute top-[42%] left-[67%] text-[4.8cqw] text-[#222]\", FIELD)}\n          >\n            {cvc}\n          </div>\n          {logo(\"bottom-[5%] left-1/2 -translate-x-1/2 object-bottom text-center opacity-60\")}\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport type { CreditCardField, CreditCardLabels, CreditCardProps };\nexport { CreditCard };\n",
      "type": "registry:component",
