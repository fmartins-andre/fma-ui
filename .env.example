# Copy to .env (git-ignored) and fill in. The registry generator and apps/web's
# dev server and build refuse to run without these (packages/registry/src/env.ts).
# In CI and in Cloudflare's build settings, set them as environment variables.

# Public URL where apps/web is deployed: the registry's homepage (consumers
# fetch <url>/r/{name}.json) and the Cloudflare Worker's custom domain.
FMA_UI_SITE_URL=https://ui.example.com
